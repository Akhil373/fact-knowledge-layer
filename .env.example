# LLM — Bynara OpenAI-compatible router
LLM_API_KEY=your_bynara_api_key_here
LLM_BASE_URL=https://router.bynara.id/v1
LLM_MODEL=muse-spark-1.2-contributor-free
LLM_ARBITER_MODEL=muse-spark-1.2-contributor-free
# Legacy Groq vars still supported as fallback
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_ARBITER_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# HF embeddings (google/embeddinggemma-300m)
HF_TOKEN=your_hf_token_here
HF_EMBEDDING_URL=https://api-inference.huggingface.co/models/google/embeddinggemma-300m
